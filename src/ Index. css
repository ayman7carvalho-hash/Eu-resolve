@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 210 40% 98.5%;
    --foreground: 215 42% 13%;
    --card: 0 0% 100%;
    --card-foreground: 215 42% 13%;
    --popover: 0 0% 100%;
    --popover-foreground: 215 42% 13%;
    --primary: 216 100% 25%;
    --primary-foreground: 0 0% 100%;
    --secondary: 158 58% 30%;
    --secondary-foreground: 0 0% 100%;
    --muted: 210 32% 95%;
    --muted-foreground: 215 16% 45%;
    --accent: 210 40% 95%;
    --accent-foreground: 216 100% 25%;
    --destructive: 356 72% 45%;
    --destructive-foreground: 0 0% 100%;
    --border: 214 26% 89%;
    --input: 214 26% 89%;
    --ring: 216 100% 40%;
    --radius: 1rem;
    --chart-1: 216 100% 35%;
    --chart-2: 158 58% 36%;
    --chart-3: 32 94% 48%;
    --chart-4: 262 60% 58%;
    --chart-5: 356 72% 52%;

    --brand-blue: 216 100% 25%;
    --brand-blue-soft: 216 60% 94%;
    --brand-green: 158 58% 30%;
    --brand-green-soft: 158 55% 94%;
    --brand-amber: 41 100% 50%;
    --brand-red: 356 72% 45%;

    --font-heading: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
    --font-body: "Inter", ui-sans-serif, system-ui, sans-serif;
    --font-display: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;

    --sidebar-background: 0 0% 100%;
    --sidebar-foreground: 215 42% 13%;
    --sidebar-primary: 216 100% 25%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 210 40% 95%;
    --sidebar-accent-foreground: 216 100% 25%;
    --sidebar-border: 214 26% 89%;
    --sidebar-ring: 216 100% 40%;
  }

  .dark {
    --background: 215 42% 9%;
    --foreground: 210 40% 98%;
    --card: 215 40% 12%;
    --card-foreground: 210 40% 98%;
    --popover: 215 40% 12%;
    --popover-foreground: 210 40% 98%;
    --primary: 216 80% 60%;
    --primary-foreground: 215 42% 9%;
    --secondary: 158 45% 45%;
    --secondary-foreground: 215 42% 9%;
    --muted: 215 30% 18%;
    --muted-foreground: 215 16% 65%;
    --accent: 215 30% 18%;
    --accent-foreground: 210 40% 98%;
    --destructive: 356 60% 45%;
    --destructive-foreground: 210 40% 98%;
    --border: 215 28% 20%;
    --input: 215 28% 20%;
    --ring: 216 80% 65%;
    --chart-1: 216 70% 60%;
    --chart-2: 158 50% 50%;
    --chart-3: 32 90% 58%;
    --chart-4: 262 55% 65%;
    --chart-5: 356 70% 60%;
    --brand-blue: 216 80% 60%;
    --brand-blue-soft: 216 30% 20%;
    --brand-green: 158 50% 48%;
    --brand-green-soft: 160 30% 18%;
    --brand-amber: 41 100% 55%;
    --brand-red: 356 70% 58%;
    --sidebar-background: 215 42% 9%;
    --sidebar-foreground: 210 40% 98%;
    --sidebar-primary: 216 80% 60%;
    --sidebar-primary-foreground: 215 42% 9%;
    --sidebar-accent: 215 30% 18%;
    --sidebar-accent-foreground: 210 40% 98%;
    --sidebar-border: 215 28% 20%;
    --sidebar-ring: 216 80% 65%;
  }
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    @apply bg-background text-foreground font-body antialiased;
  }

  h1,
  h2,
  h3,
  h4 {
    @apply font-heading;
  }
}

@layer utilities {
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .texto-titulo {
    @apply font-heading text-lg font-extrabold tracking-tight text-foreground;
  }
}

/* Leaflet: alinhar com a identidade visual */
.leaflet-container {
  font-family: var(--font-body);
  background: #e8eef5;
}

.leaflet-popup-content-wrapper {
  border-radius: 14px;
  box-shadow: 0 12px 30px -12px rgba(15, 23, 42, 0.45);
}

.leaflet-popup-content {
  margin: 12px 14px;
  font-size: 12px;
  line-height: 1.45;
}

.leaflet-control-attribution {
  font-size: 9px;
}
